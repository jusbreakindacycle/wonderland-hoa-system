# Wonderland HOA — mobile (Expo) environment
#
# Copy to `mobile/.env` and fill in. `mobile/.env` is git-ignored and must
# never be committed.
#
# Everything here is EXPO_PUBLIC_* and is therefore embedded in the shipped
# application bundle. Guide §3.6 and §17: only the project URL and a
# publishable client key belong here.
#
# NEVER put any of these in this file, in mobile/.env, in EAS public
# variables, or in any bundled asset:
#   - a Supabase service-role key
#   - a Supabase secret API key
#   - a database password
#   - an administrator's Supabase access token
#   - an Expo personal access token  (that belongs only in the EXPO_TOKEN
#     GitHub Actions secret)
#
# The root web bridge keeps its own separate VITE_* variables in `.env`. Do not
# merge the two files: privileged credentials must not move into a shared
# root/mobile file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Prefer the modern publishable key (`sb_publishable_...`) over the legacy anon
# JWT for new mobile code.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# The non-routable domain used to carry an HOA-issued login handle through
# Supabase's email-and-password credential model (Guide §10.2). It is an
# implementation transport and is never shown to a resident.
EXPO_PUBLIC_AUTH_EMAIL_DOMAIN=auth.wonderland.invalid
